  "claims": [
    {
      "id": "evrard_area_criteria",
      "attachment_key": "DX3VKLUS",
      "indexed_line_start": 21,
      "indexed_line_end": 36,
      "anchor_text_sha256": "3da92654a6135e789b3ac387883402d9280e1163be21e9feda2511b9c4a20778",
      "section": "Materials and Methods: Subjects; Histological processing; Architectonic analysis",
      "pdf_pages_1based": null,
      "journal_pages": "65-66",
      "literature_paraphrase": "Ten adult M.fascicularis; serial 50/60µm sections, Nissl and Gallyas; repeated independent two-observer mapping; area adoption requires >=300µm width across sections, abrupt multiple features, consistency across stains and cases.",
      "project_interpretation": "Histological area criterion, not coordinate-distance threshold or NMT registration tolerance."
    },
    {
      "id": "evrard_flatmap",
      "attachment_key": "DX3VKLUS",
      "indexed_line_start": 36,
      "indexed_line_end": 39,
      "anchor_text_sha256": "c4db40c3381fc750a4bcaf742e83990da27ae772814598076d193b445affb2cc",
      "section": "Architectonic analysis; Construction of the flat maps",
      "pdf_pages_1based": null,
      "journal_pages": "66",
      "literature_paraphrase": "Gross sulcal boundaries; flat maps use layerIV or III/V widths, actual section spacing and superior-limiting-sulcus reference; MRI assists sulcus positioning in five cases.",
      "project_interpretation": "Case-specific histological map, not a NMT/ARM volumetric crosswalk."
    },
    {
      "id": "evrard_fine_subareas",
      "attachment_key": "DX3VKLUS",
      "indexed_line_start": 139,
      "indexed_line_end": 153,
      "anchor_text_sha256": "3b5b14ef8b448a838104b2b4b8f8e43c34628a2be355aa1102c6ab565b7594cb",
      "section": "Results: possible subdivisions; Figs21-26",
      "pdf_pages_1based": null,
      "journal_pages": "79-81",
      "literature_paraphrase": "Numbered IDD/IDM/IDV subdivisions are tentative, based on subtle laminar/myelin transitions, with insufficient evidence then for distinct areas versus modules.",
      "project_interpretation": "Fine curated labels need explicit boundary uncertainty; cannot be accepted from a template coordinate box alone."
    },
    {
      "id": "krockenberger_injections",
      "attachment_key": "DZAU4B4N",
      "indexed_line_start": 175,
      "indexed_line_end": 214,
      "anchor_text_sha256": "a24fda143469ff9b67d916a2ac0acd48f17b289ecb5c01786643a6e6cf8d1f2a",
      "section": "2.1 Tracer injection and histological processing",
      "pdf_pages_1based": [
        4
      ],
      "journal_pages": "2022",
      "literature_paraphrase": "Five adult M.mulatta; secondary tracing material; BDA/LY/FR5/10%,0.3-1.2µl,about14days survival;50µm coronal sections in alternating one-in-ten series, Nissl and two cases Gallyas.",
      "project_interpretation": "Restricted source/injection sampling is not a full insular projectome or a validated fine-parcel crosswalk."
    },
    {
      "id": "krockenberger_independence",
      "attachment_key": "DZAU4B4N",
      "indexed_line_start": 215,
      "indexed_line_end": 270,
      "anchor_text_sha256": "bd7b65ea3a71dda81d552a3623d818e147a943d731486f567a51bddfe203ad94",
      "section": "2.2 Data analysis",
      "pdf_pages_1based": [
        4,
        5
      ],
      "journal_pages": "2022-2023",
      "literature_paraphrase": "Serial ipsilateral mapping then selected high-resolution21-level zstacks; independent >=2-examiner histological mapping without consulting adjacent tracer labeling, followed by overlay.",
      "project_interpretation": "Review soma/parcel assignments independently of desired projection patterns."
    },
    {
      "id": "krockenberger_terminal_evidence",
      "attachment_key": "DZAU4B4N",
      "indexed_line_start": 273,
      "indexed_line_end": 314,
      "anchor_text_sha256": "438045423673f13ce811330c21b056b30328f66d7ab6a0cb4d89710ed8d65c08",
      "section": "3.1 General observations",
      "pdf_pages_1based": [
        5
      ],
      "journal_pages": "2023",
      "literature_paraphrase": "Injection core/halo and spread inspected; anterograde terminal labeling recognized as stained fibers with beaded varicosities interpreted as presumptive boutons; distinct bearing fibers charted as lines; retrograde label recognized in soma/proximal dendrites.",
      "project_interpretation": "Varicosities along fibers differ from graph leaves; light microscopy does not ultrastructurally verify each synapse; no SWC passage-fiber algorithm supplied."
    },
    {
      "id": "krockenberger_limitations",
      "attachment_key": "DZAU4B4N",
      "indexed_line_start": 822,
      "indexed_line_end": 853,
      "anchor_text_sha256": "640f64bc90874f1fd4ff587da51264ea2a57682b625478089eed83ec67629715",
      "section": "4.4 Limitations of the present study and future perspectives",
      "pdf_pages_1based": [
        21,
        22
      ],
      "journal_pages": "2039-2040",
      "literature_paraphrase": "No objective quantification; fine divisions may combine IDD4/IDD5 or IDM2/IDM3 into single mildly topographic entities; fine map is not definitive.",
      "project_interpretation": "Fine-parcel sensitivity and retained provenance are warranted; fixed universal stripe assignments are unsupported."
    },
    {
      "id": "chikama_tracing",
      "attachment_key": "VPPUUD5U",
      "indexed_line_start": 21,
      "indexed_line_end": 46,
      "anchor_text_sha256": "36b0bb27e850c50bf0ba2c5adff4a63f1250aebfecde9366902a7cee5025fb47",
      "section": "Materials and Methods: Retrograde tracing study",
      "pdf_pages_1based": [
        2
      ],
      "journal_pages": "9687",
      "literature_paraphrase": "Eleven adult M.nemestrina/M.mulatta; striatal WGA-HRP/LY microinjection aided by physiology; post-injection syringe dwell limits track leakage.",
      "project_interpretation": "Actual injection extent and independent anatomical evidence matter."
    },
    {
      "id": "chikama_anterograde",
      "attachment_key": "VPPUUD5U",
      "indexed_line_start": 100,
      "indexed_line_end": 148,
      "anchor_text_sha256": "b257890cfe576b0df918c75bc4dc2ec0ce81bb173ddcf009df47f21b6357a158",
      "section": "Materials and Methods: shell double staining; Anterograde tracing study",
      "pdf_pages_1based": [
        3
      ],
      "journal_pages": "9688",
      "literature_paraphrase": "Calbindin/tracer double staining identifies shell; five adult M.fascicularis anterograde experiments use atlas/physiology-assisted insular tritiated amino-acid injections and autoradiography.",
      "project_interpretation": "Tracer-defined striatal fields are different measurements from SWC leaf/bouton counts."
    },
    {
      "id": "chikama_boundaries",
      "attachment_key": "VPPUUD5U",
      "indexed_line_start": 149,
      "indexed_line_end": 169,
      "anchor_text_sha256": "a4d49a0a4159b2da3587377bb450e5ce048bf7dead2f0ce44699b79e5898b1f6",
      "section": "Materials and Methods: Charting",
      "pdf_pages_1based": [
        3
      ],
      "journal_pages": "9688",
      "literature_paraphrase": "Somata charted by light microscopy; silver grain deposits charted under dark field; Nissl-defined broad Ia/Id/Ig scheme; difficult posterior orbital/anterior insular boundary explicitly retained.",
      "project_interpretation": "Broad scheme cannot be silently treated as exact Evrard fine labels or ARM equivalence; no implementable SWC terminal/passage separation supplied."
    },
    {
      "id": "liu_cell_annotation",
      "attachment_key": "JUAS5RLT",
      "indexed_line_start": 1255,
      "indexed_line_end": 1257,
      "anchor_text_sha256": "2c54c9183e9aba4c51748219a7ab9306ec11948810e9dacfc320ecf7fb37f2bc",
      "section": "Methods: Cell cluster annotation and name assignment",
      "pdf_pages_1based": [
        18
      ],
      "journal_pages": null,
      "literature_paraphrase": "Excitatory subclasses assigned from markers and dataset homology, with selected layer-marker validation; VENs map to molecular ET/CT subclasses.",
      "project_interpretation": "Molecular subclass annotations cannot validate our numerical parcel-presence PT/CT classifier."
    },
    {
      "id": "liu_local_synapses",
      "attachment_key": "JUAS5RLT",
      "indexed_line_start": 1272,
      "indexed_line_end": 1274,
      "anchor_text_sha256": "073903cc7bfa1d49374a1850ce93bff55d0584e98f6f956a8d4b06a10e0497f3",
      "section": "Methods: Electrophysiological recording",
      "pdf_pages_1based": [
        19
      ],
      "journal_pages": null,
      "literature_paraphrase": "Up to eight simultaneous whole-cell recordings test presynaptic-evoked unitary postsynaptic potentials; spontaneous/miniature currents and stimulation responses have explicit pharmacology/response criteria.",
      "project_interpretation": "Local physiological connectivity evidence is distinct from complete long-range axon target maps or reconstruction leaf counts."
    },
    {
      "id": "liu_morphology_annotation",
      "attachment_key": "JUAS5RLT",
      "indexed_line_start": 1296,
      "indexed_line_end": 1302,
      "anchor_text_sha256": "00969086a0811434065068115a07522368e5b46b0e36376efe356cb27eb9f637",
      "section": "Methods: Biocytin staining and morphological reconstruction; Anatomical annotation; Extraction of morphological features",
      "pdf_pages_1based": [
        21
      ],
      "journal_pages": null,
      "literature_paraphrase": "Manual x100 Neurolucida reconstructions in acute-slice material; soma-origin/pia-y coordinates;30 AP-level histological slices with Nissl/layer markers support normalized soma depth;20x20x300µm dendritic-density bins and2D smoothing.",
      "project_interpretation": "Local laminar/morphology procedures and smoothing are not NMT whole-brain terminal-map parameters or a fine-parcel crosswalk."
    },
    {
      "id": "liu_projection_limit",
      "attachment_key": "JUAS5RLT",
      "indexed_line_start": 1201,
      "indexed_line_end": 1201,
      "anchor_text_sha256": "525506faa9518099a85c97434cff26818881147c09421682f9951abc4e6caf8b",
      "section": "Discussion: final limitation paragraph",
      "pdf_pages_1based": [
        14
      ],
      "journal_pages": null,
      "literature_paraphrase": "Subcerebral targets not directly identified; actual VEN-L/VEN-S projections remain unknown despite molecular ET/CT similarity; future tracing needed.",
      "project_interpretation": "Do not convert molecular labels into target ground truth or use this atlas as proof of biological terminals."
    }
  ],
